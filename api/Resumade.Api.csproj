<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Resumade.Api</RootNamespace>
    <AssemblyName>Resumade.Api</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>36ab8fb9-9e6a-4083-af5b-92cd915db343</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PuppeteerSharp" Version="25.15.0" />
    <PackageReference Include="Resend" Version="0.24.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Preserve the local exclusions for unfinished modules after consolidation. -->
  <ItemGroup>
    <Compile Remove="Services/Applications/**;Services/Jobs/**;Services/Matching/**;Infrastructure/AI/**;Infrastructure/BackgroundJobs/**" />
    <EmbeddedResource Remove="Services/Applications/**;Services/Jobs/**;Services/Matching/**;Infrastructure/AI/**;Infrastructure/BackgroundJobs/**" />
    <None Remove="Services/Applications/**;Services/Jobs/**;Services/Matching/**;Infrastructure/AI/**;Infrastructure/BackgroundJobs/**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Infrastructure\AI\AIMessage.cs" />
    <Compile Include="Infrastructure\AI\AIProxyRequest.cs" />
    <Compile Include="Infrastructure\AI\AIProxyResponse.cs" />
    <Compile Include="Infrastructure\AI\AIProxyResult.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Migrations\" />
    <InternalsVisibleTo Include="Resumade.Api.Tests" />
  </ItemGroup>
</Project>
