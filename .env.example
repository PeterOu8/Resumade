# Copy this file to .env, replace every required value, then run:
# docker compose up --build

# Required: use independent random secrets; do not reuse them between environments.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_KEY=replace-with-at-least-32-random-characters
AUTH_SECRET=replace-with-a-long-random-auth-secret

# Public origin and optional host ports.
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
API_PORT=5011
# Local HTTP account links require Development. Use Production with an HTTPS WEB_ORIGIN when deployed.
ASPNETCORE_ENVIRONMENT=Development

# Optional integrations.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESUMADE_PROXY_TOKEN=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
